# Podcast Index API (register at https://api.podcastindex.org/)
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Identify every outbound request honestly, e.g. "DataDiscoveryDemo/0.1 (+mailto:you@example.com)"
DDM_USER_AGENT=
# Optional: days to leave a feed host alone after a 401/403 without Retry-After (default 30)
DDM_REFUSED_BACKOFF_DAYS=

# Postgres: direct connection for jobs, pooled read-only connection for the web app
DATABASE_URL=
DATABASE_URL_READONLY=

# Web app (Vercel). Session cookie signing key: 32+ random characters.
SESSION_SECRET=
# The single demo login. The hash comes from `uv run ddm hash-password`.
DEMO_LOGIN_USER=
DEMO_LOGIN_PASSWORD_HASH=
# Only for running the web app on plain http://localhost (turns off Secure cookies).
# DDM_LOCAL_HTTP=1
# API and MCP keys live in the database: `uv run ddm create-api-key --label demo --out data/demo-api-key.txt`

# Local test database only (docker compose up -d db). Tests wipe its public schema.
DDM_TEST_DATABASE_URL=postgresql://ddm:ddm-local-only@127.0.0.1:54329/ddm
